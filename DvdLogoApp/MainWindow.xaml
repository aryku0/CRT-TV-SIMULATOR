<Window x:Class="DvdLogoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DVD Logo Satisfaction"
        Width="980"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#070A0F"
        Foreground="#F7FAFC"
        FontFamily="Futura Md BT, Futura Medium, Futura, Segoe UI"
        FontWeight="Medium">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#CC101722" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#334156" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#AAB8C8" />

        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#F7FAFC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#070A0F" />
            <Setter Property="FontFamily" Value="Futura Md BT, Futura Medium, Futura, Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#E9EEF5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#D8E1EC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="5"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#F7FAFC"
                                BorderBrush="#D7E0EA"
                                BorderThickness="1"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Direction="270"
                                                  Opacity="0.24"
                                                  ShadowDepth="2"
                                                  Color="#000000" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Height="{TemplateBinding Height}">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="#F7FAFC"
                                                  Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderTrackButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="#263140"
                                                  Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrackButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeepVisibleCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Border x:Name="OptionBox"
                                    Background="#263140"
                                    BorderBrush="#4B5A6D"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                            <Ellipse x:Name="OptionCircle"
                                     Width="12"
                                     Height="12"
                                     Fill="Transparent"
                                     Stroke="#9DABBB"
                                     StrokeThickness="1.5"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                            <Ellipse x:Name="OptionDot"
                                     Width="5"
                                     Height="5"
                                     Fill="#070A0F"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBox" Property="BorderBrush" Value="#D7E0EA" />
                                <Setter TargetName="OptionCircle" Property="Stroke" Value="#F7FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBox" Property="Background" Value="#F7FAFC" />
                                <Setter TargetName="OptionBox" Property="BorderBrush" Value="#F7FAFC" />
                                <Setter TargetName="OptionCircle" Property="Stroke" Value="#070A0F" />
                                <Setter TargetName="OptionDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Border Background="#0B1018"
                BorderBrush="#253142"
                BorderThickness="1"
                CornerRadius="32"
                ClipToBounds="True">
            <Grid x:Name="ScreenSurface"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="1.018" ScaleY="1.012" />
                </Grid.RenderTransform>

                <Canvas x:Name="BounceStage"
                        ClipToBounds="True"
                        SizeChanged="BounceStage_SizeChanged">
                    <Canvas.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#05070A" Offset="0" />
                            <GradientStop Color="#111A25" Offset="0.55" />
                            <GradientStop Color="#07090D" Offset="1" />
                        </LinearGradientBrush>
                    </Canvas.Background>

                    <Image x:Name="DvdLogoImage"
                           Width="260"
                           Height="146"
                           Stretch="Uniform"
                           Opacity="0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Canvas>

                <Border x:Name="CornerCounterPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="18"
                        Padding="16,12"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="22"
                        Opacity="0">
                    <StackPanel>
                        <TextBlock Text="Corner hits"
                                   Foreground="{StaticResource SoftTextBrush}"
                                   FontSize="12"
                                   FontWeight="Medium" />
                        <TextBlock x:Name="CornerHitText"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Medium" />
                    </StackPanel>
                </Border>

                <Border x:Name="SatisfactionRevealZone"
                        Width="620"
                        Height="84"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Background="Transparent"
                        MouseEnter="SatisfactionRevealZone_MouseEnter"
                        MouseMove="SatisfactionRevealZone_MouseMove" />

                <StackPanel x:Name="ControlsPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Width="560"
                            Margin="0,0,0,28"
                            Opacity="0">
                    <Button x:Name="StartButton"
                            Content="Start"
                            Margin="0,0,0,16"
                            Style="{StaticResource RoundedButtonStyle}"
                            Cursor="Hand"
                            Click="StartButton_Click" />

                    <Border x:Name="SatisfactionPanel"
                            Padding="14,8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            MouseEnter="SatisfactionPanel_MouseEnter"
                            MouseMove="SatisfactionPanel_MouseMove"
                            PreviewMouseDown="SatisfactionPanel_PreviewMouseDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Satisfaction"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SoftTextBrush}"
                                       FontSize="13"
                                       FontWeight="Medium" />

                            <Slider x:Name="SatisfactionSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="35"
                                    TickFrequency="5"
                                    Margin="8,0,12,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RoundedSliderStyle}"
                                    ValueChanged="SatisfactionSlider_ValueChanged" />

                            <TextBlock x:Name="SatisfactionValueText"
                                       Grid.Column="2"
                                       Text="35%"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="#F7FAFC"
                                       FontSize="13"
                                       FontWeight="Medium" />

                            <CheckBox x:Name="KeepSatisfactionVisibleCheckBox"
                                      Grid.Column="3"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource KeepVisibleCheckBoxStyle}"
                                      ToolTip="Keep visible"
                                      Checked="KeepSatisfactionVisibleCheckBox_Checked"
                                      Unchecked="KeepSatisfactionVisibleCheckBox_Unchecked" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid x:Name="CrtOverlay"
                      ClipToBounds="True"
                      IsHitTestVisible="False">
                    <Rectangle Opacity="0.28"
                               SnapsToDevicePixels="True">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile"
                                          Viewport="0,0,1,5"
                                          ViewportUnits="Absolute"
                                          Viewbox="0,0,1,5"
                                          ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#22000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,1,1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#0FFFFFFF">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,3,1,1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle Opacity="0.08">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile"
                                          Viewport="0,0,6,1"
                                          ViewportUnits="Absolute"
                                          Viewbox="0,0,6,1"
                                          ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#FFFF2F2F">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,1,1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FF51FF6B">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="2,0,1,1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FF4D8BFF">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="4,0,1,1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle Opacity="0.56">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.5"
                                                 GradientOrigin="0.5,0.5"
                                                 RadiusX="0.74"
                                                 RadiusY="0.78">
                                <GradientStop Color="#00000000" Offset="0.48" />
                                <GradientStop Color="#39000000" Offset="0.78" />
                                <GradientStop Color="#C8000000" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle Opacity="0.24">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.43"
                                                 GradientOrigin="0.5,0.43"
                                                 RadiusX="0.58"
                                                 RadiusY="0.48">
                                <GradientStop Color="#24FFFFFF" Offset="0" />
                                <GradientStop Color="#0A9EEBFF" Offset="0.42" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle Margin="10"
                               RadiusX="52"
                               RadiusY="42"
                               Stroke="#32DBF4FF"
                               StrokeThickness="2"
                               Opacity="0.42" />

                    <Rectangle x:Name="CrtFlicker"
                               Fill="#FFFFFFFF"
                               Opacity="0.018">
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrtFlicker"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.012" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0.028" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0.016" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.31" Value="0.036" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.43" Value="0.014" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.61" Value="0.024" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.76" Value="0.018" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
